{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install",
  "regions": ["lhr1"],
  "crons": [
    { "path": "/api/cron/backup", "schedule": "0 3 * * 0" },
    { "path": "/api/cron/cleanup-audit-log", "schedule": "0 6 * * *" }
  ]
}
