# .env.example — имена переменных (ТЗ 2.0, §0.3, §5.8, §24, §33)
# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# --- Публичный домен ---
NEXT_PUBLIC_SITE_URL=https://zapishisya.ru

# --- Supabase (одна БД на весь проект) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Шифрование SMTP-паролей (AES-256-GCM), hex, 32 байта = 64 символа ---
ENCRYPTION_KEY=

# --- Cron (Vercel Cron и внешний планировщик: Authorization: Bearer ...) ---
CRON_SECRET=

# --- Email (Yandex 360). Пароли ящиков хранятся в БД зашифрованно, здесь только общие настройки ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993

# --- Telegram: бот владельца сервиса (§21) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram: бот для бизнесов (§36) ---
TELEGRAM_BUSINESS_BOT_TOKEN=
TELEGRAM_BUSINESS_BOT_USERNAME=

# --- Лицензии (§5.8). Заполняется только в коде, переданном клиенту ---
LICENSE_ID=
LICENSE_SERVER_URL=

# --- Абстракции миграции (§24) ---
LEGAL_MODE=unofficial
HOSTING_PROVIDER=vercel
DB_PROVIDER=supabase
STORAGE_PROVIDER=supabase
EMAIL_PROVIDER=smtp
PAYMENT_METHOD=manual

# --- Супер-админка (ТЗ §16): адреса через запятую, вход через Supabase Auth ---
SUPERADMIN_EMAILS=

# --- Webhook Telegram-бота бизнеса: секрет, который Telegram присылает в заголовке ---
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_WEBHOOK_SECRET=

# --- Vercel API (кастомные домены, §50–52) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
