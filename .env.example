# .env.example — имена переменных (ТЗ 2.0, §0.3, §5.8, §24, §33)
# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# --- Публичный домен ---
NEXT_PUBLIC_SITE_URL=https://zapishisya.ru
# Каталог сборки Next.js (next.config.mjs). По умолчанию '.next'. Переопределите, только если
# запись в project/.next заблокирована (например, в изолированной среде сборки).
NEXT_DIST_DIR=
# Дополнительные основные хосты (через запятую): алиасы, CDN, старые домены. Дополняют выведенные из SITE_URL.
# Не задано — используется только основной домен и его www-вариант.
NEXT_PUBLIC_MAIN_HOSTS=

# --- Supabase (одна БД на весь проект) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connection pooler — ОСТАВЬТЕ ПУСТЫМ на Vercel/Supabase Cloud.
# supabase-js работает по REST (HTTPS :443), а не по Postgres-wire. Порт :6543 — это
# пулер для ПРЯМЫХ Postgres-подключений (psql, pg-драйвер), он НЕ подходит для supabase-js
# и вызывает ~20-30с зависания запросов. Код сам берёт NEXT_PUBLIC_SUPABASE_URL (порт 443).
# Указывать SUPABASE_POOLER_URL имеет смысл только если у вас отдельный прокси REST на :6543
# (крайне редко). Для обычного деплоя на Vercel — не трогайте эту переменную.
SUPABASE_POOLER_URL=

# --- Шифрование SMTP-паролей (AES-256-GCM), hex, 32 байта = 64 символа ---
ENCRYPTION_KEY=

# --- Cron (Vercel Cron и внешний планировщик: Authorization: Bearer ...) ---
CRON_SECRET=

# --- Email (Yandex 360). Пароли ящиков хранятся в БД зашифрованно, здесь только общие настройки ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465

# --- Telegram: ОДИН бот на все роли (бизнес + оператор), ТЗ §18 ---
# Задайте один токен — он обслуживает и уведомления бизнесам, и команды оператора
# (админ-команды /stats, /health, /ping работают только из чата TELEGRAM_CHAT_ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Опц. отдельный бот для бизнес-уведомлений (обратная совместимость). Если пусто — берётся TELEGRAM_BOT_TOKEN.
TELEGRAM_BUSINESS_BOT_TOKEN=
TELEGRAM_BUSINESS_BOT_USERNAME=

# --- Лицензии (§5.8). Заполняется только в коде, переданном клиенту ---
LICENSE_ID=
LICENSE_SERVER_URL=

# --- Супер-админка (ТЗ §16): адреса через запятую, вход через Supabase Auth ---
SUPERADMIN_EMAILS=

# --- Webhook Telegram-бота: секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token ---
# Один бот — один webhook — один секрет.
TELEGRAM_WEBHOOK_SECRET=

# --- Vercel API (кастомные домены, §50–52) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# added from agent-13
APP_VERSION=

# --- Переменные, которые читает код (для тестов env-example: все описаны здесь) ---
# Лицензии: HMAC для /api/license/ping (секрет сервера лицензий)
LICENSE_HMAC_SECRET=
# Публичные контакты на странице блокировки и в футере
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_TELEGRAM=
# Соль для хэшей аналитики (IP и User-Agent не хранятся, только sha256)
ANALYTICS_SALT=
# Supabase: JWT-секрет для проверки токенов (lib/auth-provider.ts)
SUPABASE_JWT_SECRET=
# Предыдущий ключ шифрования: нужен на время ротации ENCRYPTION_KEY
ENCRYPTION_KEY_PREVIOUS=
# Юридические реквизиты в письмах и документах (lib/legal.ts)
LEGAL_EMAIL=
LEGAL_ADDRESS=
HASH_SALT=
# Секрет токенов отписки (ссылка unsubscribe в письмах)
UNSUBSCRIBE_SECRET=
# Альтернативное имя секрета webhook (фолбэк, ТЗ §18.1): TELEGRAM_WEBHOOK_SECRET имеет приоритет.
TELEGRAM_BIZ_SECRET=
# Telegram: соль хэшей кодов привязки и username бота для ссылок
TELEGRAM_HASH_SECRET=
TELEGRAM_BOT_USERNAME=

# --- Тесты (Playwright / Vitest). Не нужны для работы приложения ---
E2E_PORT=
E2E_BASE_URL=
CI=
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_ENCRYPTION_KEY=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ALLOW_WRITES=
E2E_ALLOW_SAME_DB=
E2E_BUSINESS_PATH=
E2E_CRON_SECRET=
MOCK_SUPABASE_PORT=
E2E_LICENSE_ID=
E2E_LICENSE_KEY=
E2E_PANEL_PATH=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_STAND=
E2E_TG_SECRET=
E2E_TG_CHAT_ID=
E2E_DB=
